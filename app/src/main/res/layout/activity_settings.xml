<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFF0F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step-Mom Harley Settings"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FF69B4"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Server Address"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/serverUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="http://192.168.1.100:11434"
        android:inputType="textUri"
        android:padding="16dp"
        android:textSize="16sp"
        android:background="@drawable/input_background"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This is the address of the AI server running on the family computer. Your step mom Harley needs to talk to it to answer your questions!"
        android:textSize="13sp"
        android:textColor="#999999"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/testButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Connection"
        android:textSize="16sp"
        android:backgroundTint="#FF69B4"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save"
        android:textSize="16sp"
        android:backgroundTint="#FF1493"
        android:textColor="#FFFFFF" />

</LinearLayout>
