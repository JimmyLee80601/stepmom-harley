<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AuntHarley.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#FF1E1E2E" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#FF89B4FA" VerticalAlignment="Center">
                <TextBlock Text="💕" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="Aunt Harley" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="StatusText" Text="Online" FontSize="12" Foreground="#FFA6E3A1"/>
            </StackPanel>

            <Button Grid.Column="2" Content="⚙" Background="Transparent" Foreground="White" FontSize="20"
                    Click="Settings_Click" VerticalAlignment="Center"/>
        </Grid>

        <!-- Chat Messages -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,8">
            <StackPanel x:Name="ChatMessages" Spacing="8">
                <!-- Welcome message -->
                <Border Background="#FF313244" CornerRadius="12" Padding="14,10" MaxWidth="500" HorizontalAlignment="Left">
                    <TextBlock Text="Hey kiddo! 💕 I'm your aunt Harley. Ask me anything — homework, ideas, or just tell me about your day!"
                               Foreground="White" TextWrapping="Wrap" FontSize="14" LineHeight="20"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Input Area -->
        <Grid Grid.Row="2" Background="#FF1E1E2E" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MessageInput" Grid.Column="0" PlaceholderText="Type a message..."
                     Background="#FF313244" Foreground="White" PlaceholderForeground="#FF6C7086"
                     CornerRadius="20" Padding="14,8" FontSize="14"
                     KeyDown="MessageInput_KeyDown" AcceptsReturn="False"
                     Margin="0,0,8,0"/>

            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Background="#FF89B4FA"
                    Foreground="#FF1E1E2E" FontWeight="SemiBold" CornerRadius="20"
                    Padding="16,8" Click="Send_Click"/>
        </Grid>
    </Grid>
</Page>